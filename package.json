{
  "name": "spawn",
  "version": "0.1.0",
  "description": "SPAWN: a Python IDE for machine learning work",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "tauri": "tauri",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && tsc --noEmit -p tsconfig.json",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "check": "npm run lint && npm run test && npm run rust:lint && npm run rust:test",
    "changelog": "git-cliff -o CHANGELOG.md",
    "icons": "rsvg-convert -w 1024 -h 1024 app-icon.svg -o /tmp/spawn-app-icon.png && tauri icon /tmp/spawn-app-icon.png -o src-tauri/icons",
    "build:linux": "tauri build --no-bundle",
    "install:linux": "npm run build:linux && bash scripts/install-linux.sh"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.4.5",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "codemirror": "^6.0.2",
    "solid-js": "^1.9.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "eslint-plugin-solid": "^0.18.0",
    "git-cliff": "^2.14.2",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^5.0.2"
  }
}
