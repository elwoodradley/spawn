{
  "name": "One Dark",
  "appearance": "dark",
  "author": "Port of Atom One Dark (MIT)",
  "colors": {
    "bg": "#282c34",
    "bgPanel": "#21252b",
    "bgElevated": "#2c313a",
    "bgHover": "#2c313a",
    "bgActive": "#3e4451",
    "fg": "#abb2bf",
    "fgMuted": "#8b93a1",
    "fgFaint": "#636d83",
    "border": "#3a3f4b",
    "accent": "#61afef",
    "accentFg": "#1e2127",
    "selection": "rgba(97, 175, 239, 0.28)",
    "cursor": "#abb2bf",
    "lineHighlight": "rgba(171, 178, 191, 0.045)",
    "gutterFg": "#636d83",
    "gutterActiveFg": "#abb2bf",
    "matchingBracket": "rgba(97, 175, 239, 0.35)",
    "success": "#98c379",
    "warning": "#e5c07b",
    "error": "#e06c75",
    "info": "#61afef",
    "stderr": "#e5c07b"
  },
  "fonts": {
    "ui": "Adwaita Sans",
    "mono": "JetBrains Mono",
    "sizeUi": 13,
    "sizeMono": 13,
    "lineHeight": 1.5
  },
  "syntax": {
    "keyword": {
      "color": "#c678dd"
    },
    "controlKeyword": {
      "color": "#c678dd"
    },
    "definitionKeyword": {
      "color": "#c678dd"
    },
    "moduleKeyword": {
      "color": "#c678dd"
    },
    "operator": {
      "color": "#56b6c2"
    },
    "string": {
      "color": "#98c379"
    },
    "docString": {
      "color": "#7f848e",
      "fontStyle": "italic"
    },
    "comment": {
      "color": "#7f848e",
      "fontStyle": "italic"
    },
    "number": {
      "color": "#d19a66"
    },
    "bool": {
      "color": "#d19a66"
    },
    "null": {
      "color": "#d19a66"
    },
    "self": {
      "color": "#e06c75",
      "fontStyle": "italic"
    },
    "function": {
      "color": "#61afef"
    },
    "className": {
      "color": "#e5c07b"
    },
    "typeName": {
      "color": "#e5c07b"
    },
    "variableName": {
      "color": "#abb2bf"
    },
    "propertyName": {
      "color": "#e06c75"
    },
    "definition": {
      "color": "#61afef"
    },
    "decorator": {
      "color": "#e5c07b"
    },
    "punctuation": {
      "color": "#8b93a1"
    },
    "bracket": {
      "color": "#8b93a1"
    },
    "invalid": {
      "color": "#e06c75",
      "textDecoration": "underline"
    },
    "escape": {
      "color": "#56b6c2"
    },
    "regexp": {
      "color": "#98c379"
    }
  },
  "plot": {
    "background": "#21252b",
    "foreground": "#abb2bf",
    "grid": "#181a1f",
    "series": ["#61afef", "#d19a66", "#98c379", "#c678dd", "#e5c07b", "#e06c75", "#56b6c2"]
