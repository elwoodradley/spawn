{
  "name": "GitHub Light",
  "appearance": "light",
  "author": "Port of GitHub's Primer light palette (MIT)",
  "colors": {
    "bg": "#ffffff",
    "bgPanel": "#f6f8fa",
    "bgElevated": "#ffffff",
    "bgHover": "#eaeef2",
    "bgActive": "#ddf4ff",
    "fg": "#1f2328",
    "fgMuted": "#59636e",
    "fgFaint": "#8c959f",
    "border": "#d1d9e0",
    "accent": "#0969da",
    "accentFg": "#ffffff",
    "selection": "rgba(9, 105, 218, 0.2)",
    "cursor": "#0969da",
    "lineHighlight": "rgba(31, 35, 40, 0.05)",
    "gutterFg": "#8c959f",
    "gutterActiveFg": "#1f2328",
    "matchingBracket": "rgba(9, 105, 218, 0.25)",
    "success": "#1a7f37",
    "warning": "#9a6700",
    "error": "#cf222e",
    "info": "#0969da",
    "stderr": "#9a6700"
  },
  "fonts": {
    "ui": "Adwaita Sans",
    "mono": "JetBrains Mono",
    "sizeUi": 13,
    "sizeMono": 13,
    "lineHeight": 1.5
  },
  "syntax": {
    "keyword": {
      "color": "#cf222e"
    },
    "controlKeyword": {
      "color": "#cf222e"
    },
    "definitionKeyword": {
      "color": "#cf222e"
    },
    "moduleKeyword": {
      "color": "#cf222e"
    },
    "operator": {
      "color": "#cf222e"
    },
    "string": {
      "color": "#0a3069"
    },
    "docString": {
      "color": "#6e7781",
      "fontStyle": "italic"
    },
    "comment": {
      "color": "#6e7781",
      "fontStyle": "italic"
    },
    "number": {
      "color": "#0550ae"
    },
    "bool": {
      "color": "#0550ae"
    },
    "null": {
      "color": "#0550ae"
    },
    "self": {
      "color": "#953800",
      "fontStyle": "italic"
    },
    "function": {
      "color": "#8250df"
    },
    "className": {
      "color": "#953800"
    },
    "typeName": {
      "color": "#953800"
    },
    "variableName": {
      "color": "#1f2328"
    },
    "propertyName": {
      "color": "#0550ae"
    },
    "definition": {
      "color": "#8250df"
    },
    "decorator": {
      "color": "#8250df"
    },
    "punctuation": {
      "color": "#59636e"
    },
    "bracket": {
      "color": "#59636e"
    },
    "invalid": {
      "color": "#cf222e",
      "textDecoration": "underline"
    },
    "escape": {
      "color": "#0550ae"
    },
    "regexp": {
      "color": "#116329"
    }
  },
  "plot": {
    "background": "#ffffff",
    "foreground": "#1f2328",
    "grid": "#d1d9e0",
    "series": ["#0969da", "#953800", "#1a7f37", "#cf222e", "#9a6700", "#0550ae"]
  }
}
