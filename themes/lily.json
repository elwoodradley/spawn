{
  "name": "Lily",
  "appearance": "light",
  "author": "Stone Toad",
  "colors": {
    "bg": "#fbfaf7",
    "bgPanel": "#f3f1ec",
    "bgElevated": "#ffffff",
    "bgHover": "#ece9e2",
    "bgActive": "#e4e0d7",
    "fg": "#2e2a26",
    "fgMuted": "#7a746c",
    "fgFaint": "#b3ada4",
    "border": "#e2ddd4",
    "accent": "#3f7d5a",
    "accentFg": "#ffffff",
    "selection": "rgba(63, 125, 90, 0.18)",
    "cursor": "#3f7d5a",
    "lineHighlight": "rgba(63, 125, 90, 0.06)",
    "gutterFg": "#b3ada4",
    "gutterActiveFg": "#2e2a26",
    "matchingBracket": "rgba(63, 125, 90, 0.25)",
    "success": "#3f7d5a",
    "warning": "#b0741a",
    "croak": "#b3302f",
    "info": "#2f6f9f",
    "stderr": "#8a6d3b"
  },
  "fonts": {
    "ui": "system-ui",
    "mono": "JetBrains Mono",
    "sizeUi": 13,
    "sizeMono": 13,
    "lineHeight": 1.5
  },
  "syntax": {
    "keyword": { "color": "#7a4a9c" },
    "controlKeyword": { "color": "#7a4a9c" },
    "definitionKeyword": { "color": "#7a4a9c" },
    "moduleKeyword": { "color": "#7a4a9c" },
    "operator": { "color": "#5c5650" },
    "string": { "color": "#3f7d5a" },
    "docString": { "color": "#6c8a75", "fontStyle": "italic" },
    "comment": { "color": "#9a948b", "fontStyle": "italic" },
