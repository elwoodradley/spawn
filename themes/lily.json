    "bool": { "color": "#2f6f9f" },
    "null": { "color": "#2f6f9f" },
    "self": { "color": "#7a4a9c" },
    "function": { "color": "#2f6f9f" },
    "className": { "color": "#b0741a" },
    "typeName": { "color": "#b0741a" },
    "variableName": { "color": "#2e2a26" },
    "propertyName": { "color": "#4a5a6a" },
    "definition": { "color": "#2e2a26", "fontWeight": "bold" },
    "decorator": { "color": "#b0741a" },
    "punctuation": { "color": "#7a746c" },
    "bracket": { "color": "#7a746c" },
    "invalid": { "color": "#b3302f", "textDecoration": "underline" },
    "escape": { "color": "#b0741a" },
    "regexp": { "color": "#3f7d5a" }
