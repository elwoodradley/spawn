{
  "name": "Rosé Pine",
  "appearance": "dark",
  "author": "Port of Rosé Pine (MIT)",
  "colors": {
    "bg": "#191724",
    "bgPanel": "#1f1d2e",
    "bgElevated": "#26233a",
    "bgHover": "#21202e",
    "bgActive": "#403d52",
    "fg": "#e0def4",
    "fgMuted": "#908caa",
    "fgFaint": "#6e6a86",
    "border": "#26233a",
    "accent": "#ebbcba",
    "accentFg": "#191724",
    "selection": "rgba(235, 188, 186, 0.28)",
    "cursor": "#e0def4",
    "lineHighlight": "rgba(224, 222, 244, 0.045)",
    "gutterFg": "#6e6a86",
    "gutterActiveFg": "#e0def4",
    "matchingBracket": "rgba(235, 188, 186, 0.35)",
    "success": "#9ccfd8",
    "warning": "#f6c177",
    "error": "#eb6f92",
    "info": "#c4a7e7",
    "stderr": "#f6c177"
