    "moduleKeyword": {
      "color": "#3e8fb0"
    },
    "operator": {
      "color": "#908caa"
    },
    "string": {
      "color": "#f6c177"
    },
    "docString": {
      "color": "#6e6a86",
      "fontStyle": "italic"
    },
    "comment": {
      "color": "#6e6a86",
      "fontStyle": "italic"
    },
    "number": {
      "color": "#eb6f92"
    },
    "bool": {
      "color": "#eb6f92"
    },
    "null": {
      "color": "#eb6f92"
    },
    "self": {
      "color": "#c4a7e7",
      "fontStyle": "italic"
    },
    "function": {
      "color": "#ebbcba"
    },
    "className": {
      "color": "#9ccfd8"
    },
    "typeName": {
      "color": "#9ccfd8"
