{
  "name": "Rosé Pine Dawn",
  "appearance": "light",
  "author": "Port of Rosé Pine (MIT)",
  "colors": {
    "bg": "#faf4ed",
    "bgPanel": "#fffaf3",
    "bgElevated": "#fffaf3",
    "bgHover": "#f4ede8",
    "bgActive": "#dfdad9",
    "fg": "#575279",
    "fgMuted": "#797593",
    "fgFaint": "#9893a5",
    "border": "#dfdad9",
    "accent": "#286983",
    "accentFg": "#faf4ed",
    "selection": "rgba(215, 130, 126, 0.2)",
    "cursor": "#575279",
    "lineHighlight": "rgba(87, 82, 121, 0.05)",
    "gutterFg": "#9893a5",
    "gutterActiveFg": "#575279",
    "matchingBracket": "rgba(215, 130, 126, 0.25)",
    "success": "#3d7a84",
    "warning": "#b36d10",
    "error": "#b4637a",
    "info": "#286983",
    "stderr": "#b4637a"
