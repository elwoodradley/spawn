  "syntax": {
    "keyword": {
      "color": "#286983"
    },
    "controlKeyword": {
      "color": "#286983"
    },
    "definitionKeyword": {
      "color": "#286983"
    },
    "moduleKeyword": {
      "color": "#286983"
    },
    "operator": {
      "color": "#797593"
    },
    "string": {
      "color": "#a86d1c"
    },
    "docString": {
      "color": "#9893a5",
      "fontStyle": "italic"
    },
    "comment": {
      "color": "#9893a5",
      "fontStyle": "italic"
    },
    "number": {
      "color": "#b4637a"
    },
    "bool": {
      "color": "#b4637a"
    },
    "null": {
      "color": "#b4637a"
    },
    "self": {
      "color": "#907aa9",
      "fontStyle": "italic"
    },
    "function": {
      "color": "#b45d58"
    },
    "className": {
      "color": "#56949f"
    },
    "typeName": {
      "color": "#56949f"
    },
    "variableName": {
      "color": "#575279"
    },
    "propertyName": {
      "color": "#907aa9"
    },
    "definition": {
      "color": "#b45d58"
    },
    "decorator": {
      "color": "#b45d58"
    },
    "punctuation": {
      "color": "#797593"
    },
    "bracket": {
      "color": "#797593"
    },
