{
  "name": "Nord",
  "appearance": "dark",
  "author": "Port of Nord by Arctic Ice Studio (MIT)",
  "colors": {
    "bg": "#2e3440",
    "bgPanel": "#292e39",
    "bgElevated": "#3b4252",
    "bgHover": "#3b4252",
    "bgActive": "#434c5e",
    "fg": "#d8dee9",
    "fgMuted": "#a6b0c3",
    "fgFaint": "#7b88a1",
    "border": "#3b4252",
    "accent": "#88c0d0",
