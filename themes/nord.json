    },
    "comment": {
      "color": "#7b88a1",
      "fontStyle": "italic"
    },
    "number": {
      "color": "#b48ead"
    },
    "bool": {
      "color": "#81a1c1"
    },
    "null": {
      "color": "#81a1c1"
    },
